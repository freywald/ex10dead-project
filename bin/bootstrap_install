#!/bin/bash

readonly ARCHIVE_DOWNLOADS_DIRECTORY="archive/downloads"
readonly ARCHIVE_INSTALLATIONS_DIRECTORY="archive/installations"
readonly CONTROL_DIRECTORY="packages.control"
readonly DYNAMIC_FILE="package-summary.dynamic"
readonly SOURCES_FILE="packages.sources"
readonly PINNED_FILE="packages.pinned.sources"

if ! declare -p installed_paths &>"/dev/null"; then
	declare -A installed_paths=()
fi

if ! declare -p handler_sourced &>"/dev/null"; then
	declare -A handler_sourced=()
fi

function bootstrap_install() {
	local url="$1" destination="$2" project_name="${3-}"
	local temporary_directory status=0 download_url="$url"

	if [[ -z "$project_name" ]]; then
		project_name="${url##*/}"
		project_name="${project_name%".git"}"
		project_name="${project_name%".zip"}"
	fi
	project_name="${project_name//"-"/"_"}"

	destination="$(__normalize_path_slashes "$destination/$project_name")"

	if [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)/?$ ]]; then
		local owner="${BASH_REMATCH[1]}" repository="${BASH_REMATCH[2]}"
		repository="${repository%".git"}"
		download_url="https://github.com/$owner/$repository/archive/refs/heads/master.zip"
	fi

	printf -v "__${project_name}_library_path" '%s/' "$destination"

	if [[ -d "$destination" ]]; then
		__info "Bootstrapping %s not necessary… skipped." "$project_name"
		return 0
	fi

	temporary_directory="$(__create_temporary_directory)"
	wget --quiet --output-document "$temporary_directory/archive.zip" -- "$download_url" || status="$(__abort_on_interrupt "$?")"
	if (( status != 0 )); then
		[[ -d "$temporary_directory" ]] && rm --recursive --force -- "$temporary_directory"
		return "$status"
	fi

	unzip -q -d "$temporary_directory/extracted" -- "$temporary_directory/archive.zip" || status="$(__abort_on_interrupt "$?")"
	if (( status != 0 )); then
		[[ -d "$temporary_directory" ]] && rm --recursive --force -- "$temporary_directory"
		return "$status"
	fi

	mkdir --parents -- "$destination"
	local entries=("$temporary_directory/extracted/"*)
	if (( ${#entries[@]} == 1 )) && [[ -d "${entries[0]}" ]]; then
		mv -- "${entries[0]}/"* "$destination/"
	else
		mv -- "$temporary_directory/extracted/"* "$destination/"
	fi

	cat > "$destination/installation-settings.markdown" <<EOF
# installation settings

- source url: ${url}
- download url: ${download_url}
- install directory: ${destination}
- installed at: $(date +%d-%m-%Y-%H-%M-%S)
EOF

	installed_paths["$project_name"]="$destination"

	local root
	root="$(dirname -- "$(dirname -- "$destination")")"
	handler="$(__normalize_path_slashes "$root/$CONTROL_DIRECTORY/$project_name")"
	if [[ -f "$handler" ]]; then
		__info "sourcing post-installation handler %s" "$handler"
		if ! source_once "$handler"; then
			__warn "handler file failed to source: %s" "$handler"
			return 1
		fi

		handler_sourced["$project_name"]=1
	fi

	[[ -d "$temporary_directory" ]] && rm --recursive --force -- "$temporary_directory"
}
