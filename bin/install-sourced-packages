#!/bin/bash

#source -- "./bin/library/base" || exit 1
#__set_script_path 1
#__enable_error_handler

# configuration start


# configuration end

function local_exit_failsafe() { __exit_failsafe; exit 1; }

# script task start

installation_root=""
branch_primary="master"
force_installation_all=false
force_download_newer=false
update_to_any_depth=false

# seen: project -> installed|checked|failed
# decided_version: project -> identity string
# decided_by: project -> who requested it
declare -A seen=()
declare -A decided_version=()
declare -A decided_by=()
declare -a queue=()

if ! declare -p installed_paths &>"/dev/null"; then
	declare -A installed_paths=()
fi

if ! declare -p registered_handlers &>"/dev/null"; then
	declare -A registered_handlers=()
fi

if ! declare -p handler_sourced &>"/dev/null"; then
	declare -A handler_sourced=()
fi

function date_stamp_from_path() {
	local path="$1"
	date -d "@$(stat --format "%Y" -- "$path")" "+%d-%m-%Y-%H-%M-%S"
}

function unique_destination() {
	local destination="$1"
	local index=1

	local candidate="$destination"
	while [[ -e "$candidate" ]]; do
		candidate="${destination}_$index"
		index="$((index + 1))" ||__expression_may_fail
	done

	printf '%s\n' "$candidate"
}

function version_from_text() {
	local text="$1"
	local version=""
	if [[ "$text" =~ (^|[^A-Za-z0-9])(v?[0-9]+([.][0-9]+){1,3}([-.][A-Za-z0-9]+)*)([^A-Za-z0-9]|$) ]]; then
		version="${BASH_REMATCH[2]}"
	fi

	printf '%s\n' "$version"
}

function settings_value() {
	local file="$1" key="$2"
	[[ ! -f "$file" ]] && return 0

	sed -n "s/^[[:space:]]*- $key: //p" -- "$file" | head -n 1
}

function parse_requirement() {
	local url="$1"
	url="${url%%"#"*}"
	url="${url%%\?*}"
	url="${url%"/"}"

	requirement_url="$url"
	requirement_kind=""
	requirement_host=""
	requirement_owner=""
	requirement_repository=""
	requirement_page=""
	requirement_branch=""
	requirement_tag=""
	requirement_version=""
	requirement_download=""
	requirement_commit=""
	requirement_explicit=false

	if [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)(.*)$ ]]; then
		requirement_kind="github"
		requirement_host="github.com"
		requirement_owner="${BASH_REMATCH[1]}"
		requirement_repository="${BASH_REMATCH[2]}"
		requirement_repository="${requirement_repository%".git"}"
		requirement_page="https://github.com/$requirement_owner/$requirement_repository"
		local rest="${BASH_REMATCH[3]}"
		rest="${rest%"/"}"
		if [[ "$rest" =~ ^/tree/(.+)$ ]]; then
			requirement_branch="${BASH_REMATCH[1]}"
			requirement_explicit=true
		elif [[ "$rest" =~ ^/archive/refs/heads/(.+)[.]zip$ ]]; then
			requirement_branch="${BASH_REMATCH[1]}"
			requirement_explicit=true
		elif [[ "$rest" =~ ^/archive/refs/tags/(.+)[.]zip$ ]]; then
			requirement_tag="${BASH_REMATCH[1]}"
			requirement_explicit=true
		elif [[ "$rest" =~ ^/archive/(.+)[.]zip$ ]]; then
			requirement_branch="${BASH_REMATCH[1]}"
			requirement_explicit=true
		elif [[ -n "$rest" && "$rest" != ".git" ]]; then
			return 1
		fi

		return 0
	fi

	if [[ "$url" =~ [.]zip$ ]]; then
		requirement_kind="zip"
		requirement_download="$url"
		requirement_version="$(version_from_text "${url##*/}")"
		requirement_explicit=true

		return 0
	fi

	return 1
}

function latest_release_tag() {
	local owner="$1" repository="$2" tag
	local status=0
	tag="$(curl -fsSL --proto '=https' --tlsv1.2 -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' "https://api.github.com/repos/$owner/$repository/releases/latest" 2>"/dev/null" | python3 -c 'import json,sys
try:
	print(json.load(sys.stdin).get("tag_name") or "")
except Exception:
	print("")
')" || status="$(__abort_on_interrupt "$?")"
	if (( status != 0 && status != 22 )); then
		return "$status"
	fi

	printf '%s\n' "$tag"
}

function branch_commit() {
	local page="$1" branch="$2" commit_hash
	commit_hash="$(git ls-remote "$page.git" "refs/heads/$branch" 2>"/dev/null" | awk '{print $1; exit}')"
	printf '%s\n' "$commit_hash"
}

function resolve_download() {
	requirement_commit=""
	latest_tag=""
	if [[ "$requirement_kind" == "zip" ]]; then
		return 0
	fi

	if $force_download_newer || [[ -z "$requirement_tag" && -z "$requirement_branch" ]]; then
		latest_tag="$(latest_release_tag "$requirement_owner" "$requirement_repository")"
	fi

	if [[ -n "$requirement_tag" ]]; then
		requirement_download="$requirement_page/archive/refs/tags/$requirement_tag.zip"
		requirement_version="$(version_from_text "$requirement_tag")"

		return 0
	fi

	if [[ -n "$requirement_branch" ]]; then
		requirement_download="$requirement_page/archive/refs/heads/$requirement_branch.zip"
		requirement_commit="$(branch_commit "$requirement_page" "$requirement_branch")"

		return 0
	fi

	if [[ -n "$latest_tag" ]]; then
		requirement_tag="$latest_tag"
		requirement_download="$requirement_page/archive/refs/tags/$requirement_tag.zip"
		requirement_version="$(version_from_text "$requirement_tag")"

		return 0
	fi

	requirement_branch="$branch_primary"
	requirement_download="$requirement_page/archive/refs/heads/$requirement_branch.zip"
	requirement_commit="$(branch_commit "$requirement_page" "$requirement_branch")"
}

function notify_newer() {
	[[ "$requirement_kind" != "github" || -z "$latest_tag" ]] && return 0

	if $requirement_explicit; then
		if [[ -n "$requirement_tag" && "$latest_tag" != "$requirement_tag" ]]; then
			__info "pinned to %s for %s; newer release %s is available" "$requirement_tag" "$requirement_project" "$latest_tag"
		elif [[ -n "$requirement_branch" ]]; then
			__info "pinned to branch %s for %s; newer release %s is available" "$requirement_branch" "$requirement_project" "$latest_tag"
		else
			__info "pinned to %s for %s" "${requirement_tag:-"$requirement_branch"}" "$requirement_project"
		fi

		return 0
	fi

	if [[ -n "$requirement_tag" && "$latest_tag" != "$requirement_tag" ]]; then
		__info "newer release %s is available for %s; staying on %s" "$latest_tag" "$requirement_project" "$requirement_tag"
	fi
}
function apply_force_download_newer() {
	! $force_download_newer && return 0

	[[ "$requirement_kind" != "github" || -z "$latest_tag" ]] && return 0

	if [[ -n "$requirement_tag" && "$latest_tag" == "$requirement_tag" ]]; then
		return 0
	fi

	if [[ -z "$requirement_tag" && -z "$requirement_branch" ]]; then
		return 0
	fi

	__info "update %s from %s to release %s" "$requirement_project" "${requirement_tag:-"$requirement_branch"}" "$latest_tag"

	requirement_branch=""
	requirement_commit=""
	requirement_tag="$latest_tag"
	requirement_download="$requirement_page/archive/refs/tags/$requirement_tag.zip"
	requirement_version="$(version_from_text "$requirement_tag")"
	requirement_explicit=true
}

function same_install() {
	local settings="$target_library_path/installation-settings.markdown"

	[[ ! -d "$target_library_path" || ! -f "$settings" ]] && return 1

	local installed_url installed_tag installed_commit
	installed_url="$(settings_value "$settings" "download url")"
	installed_tag="$(settings_value "$settings" "tag")"
	installed_commit="$(settings_value "$settings" "commit")"

	if [[ -n "$requirement_tag" ]]; then
		[[ "$installed_tag" == "$requirement_tag" ]]
		return $?
	fi

	if [[ -n "$requirement_commit" ]]; then
		[[ -n "$installed_commit" && "$installed_commit" == "$requirement_commit" ]]
		return $?
	fi

	[[ "$installed_url" == "$requirement_download" ]]
	return $?
}

function record_library() {
	if [[ -n "$requirement_version" ]]; then
		printf '# version="%s"\n' "$requirement_version" >> "$dynamic_partial"
	elif [[ -n "$requirement_tag" ]]; then
		printf '# version="%s"\n' "$requirement_tag" >> "$dynamic_partial"
	elif [[ -n "$requirement_branch" ]]; then
		printf '# version="%s"\n' "$requirement_branch" >> "$dynamic_partial"
	fi
	printf '__%s_library_path="%s/"\n' "$requirement_project" "$target_library_path" >> "$dynamic_partial"
}

function record_pin() {
	printf '# name=%s\n# type=url\n' "$requirement_project" >> "$pinned_partial"
	[[ "$entry_installation_root" != "$installation_root" ]] && printf '# installation_root=%s\n' "$entry_installation_root" >> "$pinned_partial"
	[[ "$entry_installation_path" != "library" ]] && printf '# installation_path=%s\n' "$entry_installation_path" >> "$pinned_partial"
	printf '%s\n\n' "$requirement_download" >> "$pinned_partial"
}

function record_pin_check() {
	local kind="$1" name="$2"
	printf '# name=%s\n# type=%s\n%s\n\n' "$name" "$kind" "$name" >> "$pinned_partial"
}

function backup_installation_directory() {
	local path="$1" name="$2"
	mkdir --parents -- "$installation_archive_directory"

	local destination
	destination="$(unique_destination "$installation_archive_directory/$name-$(date_stamp_from_path "$path")")"

	mv -- "$path" "$destination"

	__info "moved previous install %s -> %s" "$path" "$destination"
}

function extract_zip() {
	local zip="$1" destination="$2"
	local temporary_directory top
	temporary_directory="$(__create_temporary_directory)"
	local status=0
	unzip -q -d "$temporary_directory" -- "$zip" || status="$(__abort_on_interrupt "$?")"
	if (( status != 0 )); then
		[[ -d "$temporary_directory" ]] && rm -rf -- "$temporary_directory"
		return "$status"
	fi

	top="$(find "$temporary_directory" -mindepth 1 -maxdepth 1 -type d -print -quit)"

	if [[ -n "$top" && -z "$(find "$temporary_directory" -mindepth 1 -maxdepth 1 ! -name "$(basename -- "$top")" -print -quit)" ]]; then
		mv -- "$top" "$destination"
	else
		mkdir --parents -- "$destination"
		find "$temporary_directory" -mindepth 1 -maxdepth 1 -exec mv -- {} "$destination/" \;
	fi

	[[ -d "$temporary_directory" ]] && rm -rf -- "$temporary_directory"
}

function archive_zip() {
	local zip="$1" stem="$2"
	mkdir --parents -- "$zip_archive_directory"

	local destination
	destination="$(unique_destination "$zip_archive_directory/$stem-$(date_stamp_from_path "$zip").zip")"
	mv -- "$zip" "$destination"
	archived_zip="$destination"

	__info "archived zip %s" "$destination"
}

function write_installation_settings() {
	local destination="$1"
	cat > "$destination/installation-settings.markdown" <<EOF
# installation settings

- source url: ${requirement_url}
- project: ${requirement_project}
- kind: ${requirement_kind}
- host: ${requirement_host}
- owner: ${requirement_owner}
- repository: ${requirement_repository}
- repository page: ${requirement_page}
- branch: ${requirement_branch}
- tag: ${requirement_tag}
- version: ${requirement_version}
- commit: ${requirement_commit}
- download url: ${requirement_download}
- zip archive: ${archived_zip}
- install directory: ${destination}
- installed at: $(date +%d-%m-%Y-%H-%M-%S)
EOF
}

function abandon_partial() {
	local status="${1:-"$EXIT_INTERRUPTED"}"
	[[ -n "${installation_zip-}" && -f "$installation_zip" ]] && rm -f -- "$installation_zip"
	if ! $installation_complete && [[ -n "${installation_target-}" && -d "$installation_target" ]]; then
		backup_installation_directory "$installation_target" "${requirement_project:-"partial"}"
	fi

	[[ -n "${dynamic_partial-}" && -f "$dynamic_partial" ]] && rm -f -- "$dynamic_partial"
	[[ -n "${pinned_partial-}" && -f "$pinned_partial"  ]] && rm -f -- "$pinned_partial"

	exit "$status"
}

function check_program() {
	local name="$1"
	__guard_program_exists "$name"
	record_pin_check "program" "$name"
	seen["program:$name"]="checked"

	__info "program %s is available" "$name"
}

function check_apt_package() {
	local name="$1"
	local status_line
	status_line="$(dpkg-query -W --showformat='${Status}\n' -- "$name" 2>"/dev/null")" || status_line=""
	if [[ "$status_line" != "install ok installed" ]]; then
		__error "apt package %s is not installed" "$name"
		local_exit_failsafe
	fi
	record_pin_check "apt" "$name"
	seen["apt:$name"]="checked"

	__info "apt package %s is installed" "$name"
}

function requirement_identity() {
	if [[ -n "$requirement_tag" ]]; then
		printf '%s' "$requirement_tag"
	elif [[ -n "$requirement_branch" ]]; then
		printf '%s' "branch:$requirement_branch"
	elif [[ -n "$requirement_version" ]]; then
		printf '%s' "$requirement_version"
	else
		printf '%s' "$requirement_download"
	fi
}

function record_decision() {
	local project="$1" identity="$2" requester="$3"
	decided_version["$project"]="$identity"
	decided_by["$project"]="$requester"
}

function check_conflict() {
	local project="$1" identity="$2" requester="$3"

	if [[ -z "${decided_version["$project"]-}" ]]; then
		record_decision "$project" "$identity" "$requester"
		return 0
	fi

	if [[ "${decided_version["$project"]}" == "$identity" ]]; then
		return 0
	fi

	__error "version conflict for %s: %s wants %s, %s wants %s" "$project" "${decided_by["$project"]}" "${decided_version["$project"]}" "$requester" "$identity"
	local_exit_failsafe
}

function register_handler() {
	local id="$1" function_name="$2"

	if [[ -n "${registered_handlers["$id"]-}" ]]; then
		return 0
	fi

	registered_handlers["$id"]="$function_name"
}

function run_handlers() {
	local id function_name status failed=0

	for id in "${!registered_handlers[@]}"; do
		function_name="${registered_handlers["$id"]}"
		__info "running handler %s (%s)" "$id" "$function_name"

		status=0
		"$function_name" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )); then
			__warn "handler %s failed with status %s" "$id" "$status"
			failed=1
		fi
	done

	return "$failed"
}

function enqueue_nested() {
	local library_path="$1" depth="$2"

	local nested=""
	if [[ -f "$library_path/$PINNED_FILE" ]] && ! $force_download_newer; then
		nested="$library_path/$PINNED_FILE"
	elif [[ -f "$library_path/$SOURCES_FILE" ]]; then
		nested="$library_path/$SOURCES_FILE"
	fi

	[[ -z "$nested" ]] && return 0

	queue+=("$nested"$'\t'"$depth"$'\t'"$(basename -- "$library_path")")
}

function process_requirement() {
	local file="$1" depth="$2" requester="${3:-"top-level"}"

	if [[ ! -f "$file" ]]; then
		__error "requirements file not found: %s" "$file"
		local_exit_failsafe
	fi

	__heading "Parsing sources"
	__info "Parsing file %s…" "$file"
	parse_sources_file "$file" --new-line-format || __failure "Parsing failed!"
	if ! validate_tree; then
		__failure "Validating sources failed!"
		 if ! $print_sources; then
			__error "Tree validation failed!"
			local_exit_failsafe
		fi
	fi

	__success "Parsing completed."

	if $print_sources; then
		print_tree true true
		__info "[%s] done." "__$__current_script_name"
		exit 0
	fi

	$__debug && print_tree true true

	__info "Reading input. Generating tree…"
	generate_tree
	__info "Generating tree… done."

	local key
	for key in "${tree_order[@]}"; do
		local name type value
		name="$(get_metadata "name" "$key")" || name=""
		type="$(get_metadata "type" "$key")" || type=""
		value="$(get_metadata "_" "$key")" || value=""

		entry_installation_root="$(get_metadata "installation_root" "$key")" || entry_installation_root=""
		entry_installation_path="$(get_metadata "installation_path" "$key")" || entry_installation_path=""

		entry_installation_root="$(__trim_whitespaces "$entry_installation_root")"
		entry_installation_path="$(__trim_whitespaces "$entry_installation_path")"

		[[ -z "$entry_installation_root" ]] && entry_installation_root="$installation_root"
		[[ -z "$entry_installation_path" ]] && entry_installation_path="library"

		entry_installation_root="${entry_installation_root%"/"}"
		entry_installation_path="${entry_installation_path%"/"}"
		entry_installation_path="${entry_installation_path#"/"}"

		[[ -z "$value" ]] && continue

		name="$(__trim_whitespaces "$name")"
		type="$(__trim_whitespaces "$type")"
		value="$(__trim_whitespaces "$value")"

		if [[ -z "$type" && "$value" == "http"* ]]; then
			type="url"
		fi

		case "$type" in
			"program")
				local program_name="${name:-"$value"}"
				[[ -n "${seen["program:$program_name"]-}" ]] && continue
				check_program "$program_name"
				continue
				;;
			"apt")
				local package_name="${name:-"$value"}"
				[[ -n "${seen["apt:$package_name"]-}" ]] && continue
				check_apt_package "$package_name"
				continue
				;;
			"url"|"")
				;;
			*)
				__error "unknown type %s in %s" "$type" "$file"
				local_exit_failsafe
				;;
		esac

		local project="$name"
		if [[ -z "$project" || "$project" == *[!A-Za-z0-9_]* ]]; then
			__error "project name missing or not sanitized in %s: %s" "$file" "$value"
			local_exit_failsafe
		fi

		__info "Requirement: %s" "$value"

		requirement_url="" requirement_kind="" requirement_host="" requirement_owner="" requirement_repository="" requirement_page=""
		requirement_branch="" requirement_tag="" requirement_version="" requirement_download="" requirement_commit=""
		requirement_explicit=false latest_tag="" archived_zip=""
		requirement_project="$project"

		if ! parse_requirement "$value"; then
			__error "cannot parse requirement %s in %s" "$value" "$file"
			local_exit_failsafe
		fi

		local entry_tag entry_branch
		entry_tag="$(get_metadata "tag" "$key")" || entry_tag=""
		entry_branch="$(get_metadata "branch" "$key")" || entry_branch=""
		entry_tag="$(__trim_whitespaces "$entry_tag")"
		entry_branch="$(__trim_whitespaces "$entry_branch")"

		if [[ -n "$entry_tag" ]]; then
			requirement_tag="$entry_tag"
			requirement_branch=""
			requirement_explicit=true
		elif [[ -n "$entry_branch" ]]; then
			requirement_branch="$entry_branch"
			requirement_tag=""
			requirement_explicit=true
		fi

		resolve_download

		if (( depth == 0 )) || $update_to_any_depth; then
			apply_force_download_newer
		fi

		notify_newer

		local identity
		identity="$(requirement_identity)"
		check_conflict "$project" "$identity" "$requester"

		local handlers_directory
		handlers_directory="$(dirname -- "$file")/$CONTROL_DIRECTORY"
		local handler="$handlers_directory/$project"
		if [[ -f "$handler" ]]; then
			__info "sourcing post-installation handler %s" "$handler"
			__require_once "$handler"
			handler_sourced["$project"]=1
		fi

		if [[ -n "${installed_paths["$project"]-}" ]]; then
			target_library_path="${installed_paths["$project"]}"
			target_library_path="$(__normalize_path_slashes "$target_library_path")"
			__info "already installed at %s, skipping %s" "$target_library_path" "$project"

			record_library
			seen["$project"]="installed"

			local depth_next
			depth_next="$((depth + 1))" || __expression_may_fail
			enqueue_nested "$target_library_path" "$depth_next"

			continue
		fi

		if [[ -n "${seen["$project"]-}" ]]; then
			continue
		fi

		record_pin

		target_library_path="$entry_installation_root/$entry_installation_path/$project"
		target_library_path="$(__normalize_path_slashes "$target_library_path")"
		installation_target=""
		installation_zip=""
		installation_complete=false

		if [[ -L "$target_library_path" ]]; then
			__info "already locally linked, skipping external install of %s" "$project"
			record_library
			seen["$project"]="installed"

			local depth_next
			depth_next="$((depth + 1))" || __expression_may_fail
			enqueue_nested "$target_library_path" "$depth_next"

			continue
		fi

		if [[ -e "$target_library_path" && ! -d "$target_library_path" ]]; then
			__error "install path exists and is not a directory: %s" "$target_library_path"
			local_exit_failsafe
		fi

		if ! $force_installation_all && same_install; then
			__info "already installed, skipping %s" "$project"
			record_library
			seen["$project"]="installed"

			local depth_next
			depth_next="$((depth + 1))" || __expression_may_fail
			enqueue_nested "$target_library_path" "$depth_next"

			continue
		fi

		if [[ -d "$target_library_path" ]]; then
			backup_installation_directory "$target_library_path" "$project"
		fi

		__info "installing %s from %s" "$project" "$requirement_download"

		installation_target="$target_library_path"
		mkdir --parents -- "$(dirname -- "$installation_target")"

		local zip_temporary
		zip_temporary="$(__create_temporary_file).zip"
		installation_zip="$zip_temporary"

		local status=0
		curl -fL --retry 3 --retry-delay 2 -o "$zip_temporary" -- "$requirement_download" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )); then
			[[ -f "$zip_temporary" ]] && rm -f -- "$zip_temporary"
			installation_zip=""
			installation_target=""
			seen["$project"]="failed"

			__error "download failed: %s" "$requirement_download"
			local_exit_failsafe
		fi

		if ! extract_zip "$zip_temporary" "$target_library_path"; then
			archive_zip "$zip_temporary" "${project}-failed"
			installation_zip=""
			[[ -e "$target_library_path" ]] && backup_installation_directory "$target_library_path" "$project"
			installation_target=""
			seen["$project"]="failed"

			__error "extract failed: %s" "$value"
			local_exit_failsafe
		fi

		installation_zip=""
		local stem="$project"
		if [[ -n "$requirement_tag" ]]; then
			stem="${project}-${requirement_tag}"
		elif [[ -n "$requirement_branch" ]]; then
			stem="${project}-${requirement_branch}"
		fi

		archive_zip "$zip_temporary" "$stem"

		write_installation_settings "$target_library_path"

		installation_complete=true
		installation_target=""

		record_library
		seen["$project"]="installed"
		installed_paths["$project"]="$target_library_path"

		local depth_next
		depth_next="$((depth + 1))" || __expression_may_fail
		enqueue_nested "$target_library_path" "$depth_next"
	done
}

function install_package() {
	print_sources=false

	while (($# > 0)); do
		if [[ "$1" == "--debug" ]]; then
			__debug=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--verbose" ]]; then
			__verbose=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--quiet" ]]; then
			__quiet=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--print" || "$1" == "--print-sources" ]]; then
			print_sources=true
			shift || __expression_may_fail
		elif [[ "$1" == "--installation-root" ]]; then
			if [[ -z "${2-}" ]]; then
				__error "--installation-root requires a path"
				local_exit_failsafe
			fi
			installation_root="$2"
			shift 2 ||__expression_may_fail
		elif [[ "$1" == "--installation-root="* ]]; then
			if [[ -z "${1#--installation-root=}" ]]; then
				__error "--installation-root requires a path"
				local_exit_failsafe
			fi
			installation_root="${1#--installation-root=}"
			shift ||__expression_may_fail
		elif [[ "$1" == "--force-install-all" ]]; then
			force_installation_all=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--force-download-newer" || "$1" == "--update" ]]; then
			force_download_newer=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--update-to-any-depth" ]]; then
			force_download_newer=true
			update_to_any_depth=true
			shift ||__expression_may_fail
		else
			__error "unknown program argument %s" "$1"
			local_exit_failsafe
		fi
	done

	installation_root="${installation_root%"/"}"

	if [[ -z "$installation_root" ]]; then
		__error "installation_root is empty or not set"
		local_exit_failsafe
	fi

	__require_once -- "bootstrap_install"

	__info "[%s] installing sourced packages" "__$__current_script_name"

	if ! (cd -- "$installation_root"); then
		__error "cannot cd into installation root: %s" "$installation_root"
		local_exit_failsafe
	fi

	if [[ ! -f "$installation_root/FLAG_IS_PROJECT" ]]; then
		__error "project flag file does not mark installation root: %s" "$installation_root/FLAG_IS_PROJECT"
		local_exit_failsafe
	fi

	bootstrap_install "https://github.com/freywald/sourcetree-datafile-format" "$installation_root/core-library"
	__require_once -- "$__sourcetree_datafile_format_library_path/library/sourcetree-datafile-format"

	input_file="$(__normalize_path_slashes "$installation_root/$SOURCES_FILE")"
	pinned_file="$(__normalize_path_slashes "$installation_root/$PINNED_FILE")"
	zip_archive_directory="$(__normalize_path_slashes "$installation_root/$ARCHIVE_DOWNLOADS_DIRECTORY/")"
	installation_archive_directory="$(__normalize_path_slashes "$installation_root/$ARCHIVE_INSTALLATIONS_DIRECTORY/")"
	dynamic_file="$(__normalize_path_slashes "$installation_root/$DYNAMIC_FILE")"

	if [[ ! -f "$input_file" ]]; then
		__error "input file not found: %s" "$input_file"
		local_exit_failsafe
	fi

	source_file="$input_file"

	if $force_download_newer; then
		__info "updating from %s" "$input_file"
	elif [[ -f "$pinned_file" && -s "$pinned_file" ]]; then
		source_file="$pinned_file"
		__info "requirements are pinned; using %s" "$pinned_file"
	else
		__info "no pin file; using %s" "$input_file"
	fi

	if [[ -f "$dynamic_file" ]]; then
		__require_once -- "$dynamic_file"
		for variable in ${!__*}; do
			[[ "$variable" != *_library_path ]] && continue
			project="${variable#"__"}"
			project="${project%_library_path}"
			installed_paths["$project"]="$(__normalize_path_slashes "${!variable}")"
		done
	fi

	mkdir --parents -- "$zip_archive_directory" "$installation_archive_directory" "$(dirname -- "$dynamic_file")"

	dynamic_partial="$(__create_temporary_file)"
	pinned_partial="$(__create_temporary_file)"
	installation_target=""
	installation_zip=""
	installation_complete=false

	trap 'abandon_partial $EXIT_INTERRUPTED' "INT"
	trap 'abandon_partial $EXIT_TERMINATED' "TERM"

	__info "[%s] building bibliography" "__$__current_script_name"

	# breadth-first queue of "file<TAB>depth"
	queue+=("$source_file"$'\t'"0")

	while ((${#queue[@]} > 0)); do
		entry="${queue[0]}"
		queue=("${queue[@]:1}")

		file="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		depth="${rest%%$'\t'*}"
		requester="${rest#*$'\t'}"
		[[ "$requester" == "$depth" ]] && requester="top-level"

		process_requirement "$file" "$depth" "$requester"
	done

	mv -f -- "$dynamic_partial" "$dynamic_file"
	if [[ -s "$pinned_partial" ]]; then
		mv -f -- "$pinned_partial" "$pinned_file"
	else
		rm -f -- "$pinned_partial"
	fi

	trap - "INT" "TERM"

	__heading "Checking handlers"

	missing=false
	for project in "${!installed_paths[@]}"; do
		if [[ -z "${handler_sourced["$project"]-}" ]]; then
			__warn "handler file missing for %s" "$project"
			missing=true
		fi
	done

	if $missing; then
		__error "Installation failed"
		local_exit_failsafe
	fi

	__heading "Running handlers"
	for project in "${!seen[@]}"; do
		if [[ "${seen["$project"]}" == "failed" ]]; then
			__error "installation failed for %s, skipping handlers" "$project"
			local_exit_failsafe
		fi
	done

	if ! run_handlers; then
		__error "one or more handlers failed"
		local_exit_failsafe
	fi

	__info "[%s] done." "__$__current_script_name"
}
